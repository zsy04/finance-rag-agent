# ═══════════════════════════════════════════
# 财税助手 Docker 部署配置
# 复制为 .env 后修改
# ═══════════════════════════════════════════

# DeepSeek API Key（必填）
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 嵌入模型设备（可选，默认 auto）
# auto = 自动检测 GPU/CPU
# cpu  = 强制 CPU（无显卡用户）
# cuda = 强制 GPU
EMBEDDING_DEVICE=auto

# HuggingFace 镜像（国内用户建议启用，下载模型更快）
# HF_ENDPOINT=https://hf-mirror.com
