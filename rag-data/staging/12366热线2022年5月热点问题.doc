                    <h2 class="articleTit">12366热线2022年5月热点问题</h2>
                    <h2 class="articlesubTit"></h2>
                    <div id="othermessage" class="clearfix">
                        <span>日期：2022-06-15</span>
                        <span class="con-source">来源:国家税务总局河南省税务局</span>
                       <span class="fontSize" id="fontSize"> 字号： 
                            [<a id="bigFont">大</a>]
                            [<a id="middleFont">中</a>]
                            [<a id="smallFont">小</a>] 
                        </span>
                        <a id="printPage">打印本页</a> 
                        <a id="downloadPage">下载本页</a> 
                        <div class="bdsharebuttonbox">
                            <span class="u_share iconfont icontubiao212"></span>
                            <a href="#" class="bds_tsina iconfont iconweibo share-btn" data-cmd="dahe_tsina" title="分享到新浪微博"></a>
