            {"level": 5, "monthly_income_range": "35000-55000元", "monthly_income_low": 35000, "monthly_income_high": 55000, "rate": 0.30, "quick_deduction": 4410},
            {"level": 6, "monthly_income_range": "55000-80000元", "monthly_income_low": 55000, "monthly_income_high": 80000, "rate": 0.35, "quick_deduction": 7160},
            {"level": 7, "monthly_income_range": "超过80000元", "monthly_income_low": 80000, "rate": 0.45, "quick_deduction": 15160}
          ]
        },
        "method_merge": {
          "label": "并入综合所得",
          "note": "年终奖与全年工资合并，统一按综合所得税率表计算"
        }
      },
      "calculation_workflow": {
        "description": "个税计算完整流程（Agent 工具调用指引）",
        "monthly_withholding": {
          "label": "月度累计预扣",
          "step1": "累计收入 = 当月工资 + 前几月累计工资",
          "step2": "累计免税收入 = 当月5000 + 前几月累计5000",
          "step3": "累计专项扣除 = 当月三险一金 + 前几月累计",
          "step4": "累计专项附加扣除 = 当月各项 + 前几月累计",
          "step5": "累计应纳税所得额 = 累计收入 - 累计免税 - 累计专项扣除 - 累计专项附加扣除",
          "step6": "累计应纳税额 = 累计应纳税所得额 × 税率 - 速算扣除数",
          "step7": "当月应纳税额 = 累计应纳税额 - 前几月已缴税额",
          "formula": "当月个税 = MAX(0, 累计应纳税额 - 已缴税额)"
        },
        "annual_settlement": {
          "label": "年度汇算清缴",
          "step1": "年综合所得收入额 = 工资 + 劳务报酬×80% + 稿酬×56% + 特许权使用费×80%",
          "step2": "年应纳税所得额 = 年综合所得收入额 - 60000 - 年专项扣除 - 年专项附加扣除 - 其他扣除",
          "step3": "年应纳税额 = 年应纳税所得额 × 税率 - 速算扣除数",
          "step4": "应退/补税额 = 年应纳税额 - 全年已预缴税额",
          "note": "应退/补 > 0 则补税，< 0 则退税"
        },
        "annual_bonus_comparison": {
          "label": "年终奖计税方式选择",
          "note": "系统应同时计算两种方式并推荐税额较低的方案",
          "method": "分别用单独计税和合并计税计算总个税，取较低者"
        }
      },
