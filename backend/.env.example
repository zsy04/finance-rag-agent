# 财税助手后端环境变量配置模板
# 复制此文件为 .env 并填入真实值

# ====== DeepSeek API（必填）======
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your-api-key-here

# 可选：覆盖默认模型（默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# ====== Qdrant 向量数据库 ======
# 本地 Docker 部署时使用默认配置
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=finance_knowledge

# ====== CORS 允许来源 ======
# 开发环境默认 localhost:5173，生产环境改为实际域名
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# ====== 嵌入模型设备 ======
# auto(自动检测GPU) / cpu(强制CPU) / cuda(强制GPU)
# EMBEDDING_DEVICE=auto

# ====== SQLite 数据库路径 ======
# 默认 backend/data/chat.db，可自定义
# SQLITE_DB_PATH=/path/to/your/chat.db

# ====== Agent 模式 ======
# multi(Multi-Agent形态) / tools(纯工具形态)
# AGENT_MODE=multi
